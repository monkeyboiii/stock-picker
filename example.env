##
## Database Configuration
##

POSTGRES_USERNAME=<your_username>
POSTGRES_PASSWORD=<your_password>
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=<your_database>


##
## Redis Configuration (Cache & Secrets)
##

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_PREFIX=stock_picker:
REDIS_DEFAULT_TTL=3600

# Secrets Encryption Key (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
SECRETS_ENCRYPTION_KEY=


##
## Logto OIDC Authentication
##

LOGTO_ENDPOINT=https://your-logto-instance.com
LOGTO_APP_ID=<your_app_id>
LOGTO_APP_SECRET=<your_app_secret>
LOGTO_RESOURCE=https://api.stock-picker.com


##
## Google Sheets Integration
##

GOOGLE_SHEET_ID=1Wfx8vpXIIWCfuPWQaGbGrKpg-O3wbUWVj6t3kmk0L_Q


##
## API Configuration
##

# CORS allowed origins (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com


